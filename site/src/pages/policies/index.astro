---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchBar from "../../components/SearchBar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getAllPolicies } from "../../lib/policies";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import type { Source, Policy } from "../../lib/types";

const DATA_DIR = join(process.cwd(), "..", "data");
const sourcesRaw = readFileSync(join(DATA_DIR, "sources.json"), "utf-8");
const sources: Source[] = JSON.parse(sourcesRaw);

const policies = getAllPolicies();
const regions = ["全国", "北京市", "上海市", "广东省", "浙江省", "江苏省"];
const allMonths = [...new Set(policies.map(p => (p.publishDate || "").slice(0, 7)).filter(Boolean))].sort().reverse();
---

<BaseLayout title="政策列表">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumb segments={[{ label: "政策列表" }]} />

    <h1 class="text-2xl font-bold text-gray-900 mb-6">政策列表</h1>

    <div class="flex gap-6 flex-col md:flex-row">
      <!-- 筛选侧栏 -->
      <aside class="md:w-60 shrink-0">
        <div class="bg-white border border-gray-200 rounded-lg p-4 space-y-5 sticky top-20">
          <div>
            <SearchBar placeholder="搜索政策..." />
          </div>

          <div>
            <h4 class="text-sm font-semibold text-gray-700 mb-2">来源</h4>
            {sources.map((src) => (
              <label class="flex items-center gap-2 py-1 text-sm text-gray-600 cursor-pointer hover:text-gray-900 checkbox-filter"
                data-filter-type="source" data-filter-value={src.id}>
                <input type="checkbox" class="rounded border-gray-300 filter-checkbox" />
                {src.name}
              </label>
            ))}
          </div>

          <div>
            <h4 class="text-sm font-semibold text-gray-700 mb-2">地区</h4>
            {regions.map((r) => (
              <label class="flex items-center gap-2 py-1 text-sm text-gray-600 cursor-pointer hover:text-gray-900 checkbox-filter"
                data-filter-type="region" data-filter-value={r}>
                <input type="checkbox" class="rounded border-gray-300 filter-checkbox" />
                {r}
              </label>
            ))}
          </div>

          <div>
            <h4 class="text-sm font-semibold text-gray-700 mb-2">月份</h4>
            <select id="month-select" class="text-sm border border-gray-300 rounded px-2 py-1 w-full">
              <option value="">全部月份</option>
              {allMonths.map(m => <option value={m}>{m.replace('-', '年')}月</option>)}
            </select>
          </div>
        </div>
      </aside>

      <!-- 结果区域 -->
      <div class="flex-1">
        <div id="results-header" class="flex items-center justify-between mb-4">
          <p id="result-count" class="text-sm text-gray-500">
            共 {policies.length} 条政策
          </p>
          <select id="sort-order" class="text-sm border border-gray-300 rounded px-2 py-1">
            <option value="desc">最新优先</option>
            <option value="asc">最早优先</option>
          </select>
        </div>

        {policies.length > 0 ? (
          <>
            <div id="policy-list" class="space-y-3">
              {policies.slice(0, 20).map((p) => (
                <a
                  href={`/policies/${p.id}`}
                  class="block bg-white rounded-lg border border-gray-200 p-4 hover:shadow-md hover:border-blue-300 transition-all no-underline"
                >
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-base font-semibold text-gray-900 leading-snug mb-1 flex-1">
                      {p.title}
                    </h3>
                    {p.documentNumber && (
                      <span class="text-xs text-gray-400 whitespace-nowrap shrink-0">
                        {p.documentNumber}
                      </span>
                    )}
                  </div>
                  <div class="flex flex-wrap items-center gap-2 mt-2 text-xs">
                    <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800">
                      {p.sourceName || p.sourceId}
                    </span>
                    {p.publishDate && (
                      <span class="text-gray-500">{p.publishDate}</span>
                    )}
                  </div>
                  {p.summary && (
                    <p class="text-sm text-gray-600 mt-2 line-clamp-2 leading-relaxed">
                      {p.summary}
                    </p>
                  )}
                  {p.tags && p.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {p.tags.slice(0, 4).map((tag) => (
                        <span class="text-xs px-1.5 py-0.5 bg-gray-100 text-gray-500 rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
            <div id="pagination" class="mt-6 flex items-center justify-center gap-2 text-sm">
              <button id="prev-page" class="px-3 py-1.5 bg-white border border-gray-300 rounded hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed" disabled>
                上一页
              </button>
              <span id="page-info" class="px-3 py-1.5 text-gray-600">1</span>
              <button id="next-page" class="px-3 py-1.5 bg-white border border-gray-300 rounded hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed">
                下一页
              </button>
            </div>
          </>
        ) : (
          <div class="text-center py-16 text-gray-400">
            <p class="text-lg">暂无政策数据</p>
            <p class="text-sm mt-1">爬虫部署后将每日自动从政府网站采集最新政策。</p>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // @ts-nocheck
  const policies = JSON.parse(document.getElementById('policies-data')?.textContent || '[]');
  const PAGE_SIZE = 20;
  let filtered = [...policies];
  let currentPage = 1;

  function renderList() {
    const sortOrder = document.getElementById('sort-order').value;
    const sorted = [...filtered].sort((a, b) => {
      const da = new Date(a.publishDate || a.crawlDate || 0).getTime();
      const db = new Date(b.publishDate || b.crawlDate || 0).getTime();
      return sortOrder === 'desc' ? db - da : da - db;
    });

    const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageItems = sorted.slice(start, start + PAGE_SIZE);

    const list = document.getElementById('policy-list');
    const count = document.getElementById('result-count');
    const pageInfo = document.getElementById('page-info');
    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');

    count.textContent = `共 ${filtered.length} 条政策`;

    if (pageItems.length === 0) {
      list.innerHTML = '<div class="text-center py-16 text-gray-400"><p class="text-lg">无匹配政策</p><p class="text-sm mt-1">请调整筛选条件后重试。</p></div>';
    } else {
      list.innerHTML = pageItems.map(p => `
        <a href="/policies/${p.id}" class="block bg-white rounded-lg border border-gray-200 p-4 hover:shadow-md hover:border-blue-300 transition-all no-underline">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-base font-semibold text-gray-900 leading-snug mb-1 flex-1">${escapeHtml(p.title)}</h3>
            ${p.documentNumber ? `<span class="text-xs text-gray-400 whitespace-nowrap shrink-0">${escapeHtml(p.documentNumber)}</span>` : ''}
          </div>
          <div class="flex flex-wrap items-center gap-2 mt-2 text-xs">
            <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800">${escapeHtml(p.sourceName || p.sourceId)}</span>
            ${p.publishDate ? `<span class="text-gray-500">${p.publishDate}</span>` : ''}
          </div>
          ${p.summary ? `<p class="text-sm text-gray-600 mt-2 line-clamp-2 leading-relaxed">${escapeHtml(p.summary)}</p>` : ''}
          ${p.tags && p.tags.length > 0 ? `<div class="flex flex-wrap gap-1.5 mt-2">${p.tags.slice(0, 4).map(t => `<span class="text-xs px-1.5 py-0.5 bg-gray-100 text-gray-500 rounded">${escapeHtml(t)}</span>`).join('')}</div>` : ''}
        </a>
      `).join('');
    }

    pageInfo.textContent = `${currentPage} / ${totalPages}`;
    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= totalPages;
  }

  function escapeHtml(text) {
    const d = document.createElement('div');
    d.textContent = text || '';
    return d.innerHTML;
  }

  function applyFilters() {
    const selectedSources = [];
    const selectedRegions = [];

    document.querySelectorAll('.filter-checkbox').forEach(cb => {
      const label = cb.closest('.checkbox-filter');
      if (!label || !cb.checked) return;
      const type = label.dataset.filterType;
      const value = label.dataset.filterValue;
      if (type === 'source') selectedSources.push(value);
      else if (type === 'region') selectedRegions.push(value);
    });

    const monthFilter = document.getElementById('month-select').value;

    filtered = policies.filter(p => {
      if (selectedSources.length > 0 && !selectedSources.includes(p.sourceId)) return false;
      if (selectedRegions.length > 0 && !selectedRegions.some(r => (p.regions || []).includes(r))) return false;
      if (monthFilter && !(p.publishDate || '').startsWith(monthFilter)) return false;
      return true;
    });

    currentPage = 1;
    renderList();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(location.search);
    const monthParam = params.get('month');
    const monthSelect = document.getElementById('month-select');
    if (monthParam && monthSelect) {
      monthSelect.value = monthParam;
      applyFilters();
    }
    document.querySelectorAll('.filter-checkbox').forEach(cb => {
      cb.addEventListener('change', applyFilters);
    });
    document.getElementById('sort-order')?.addEventListener('change', () => { currentPage = 1; renderList(); });
    document.getElementById('prev-page')?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderList(); } });
    document.getElementById('next-page')?.addEventListener('click', () => {
      const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
      if (currentPage < totalPages) { currentPage++; renderList(); }
    });
    monthSelect?.addEventListener('change', applyFilters);
  });
</script>

<script type="application/json" id="policies-data">{JSON.stringify(policies)}</script>
