---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getAllCategories, getCategoryById } from "../../lib/categories";
import { getAllPolicies } from "../../lib/policies";
import type { Category } from "../../lib/types";

export async function getStaticPaths() {
  const cats = getAllCategories();
  return cats.map((cat) => ({
    params: { slug: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props as { category: Category };
const allPolicies = getAllPolicies();
const categoryPolicies = allPolicies.filter((p) => p.category === category.id);

const subcategoryCounts: Record<string, number> = {};
for (const p of categoryPolicies) {
  if (p.subcategory) {
    subcategoryCounts[p.subcategory] = (subcategoryCounts[p.subcategory] || 0) + 1;
  }
}
---

<BaseLayout title={category.name}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumb
      segments={[
        { label: "政策分类", href: "/policies" },
        { label: category.name },
      ]}
    />

    <div class="mb-8">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">
        {category.icon} {category.name}
      </h1>
      <p class="text-gray-600">{category.description}</p>
    </div>

    {category.subcategories && category.subcategories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {category.subcategories.map((sub) => {
          const count = subcategoryCounts[sub.id] || 0;
          return (
            <span class="px-3 py-1.5 text-sm bg-white border border-gray-200 rounded-full text-gray-600">
              {sub.name}
              {count > 0 && <span class="ml-1 text-gray-400">({count})</span>}
            </span>
          );
        })}
      </div>
    )}

    {categoryPolicies.length > 0 ? (
      <div class="space-y-3">
        {categoryPolicies.map((p) => (
          <a
            href={`/policies/${p.id}`}
            class="block bg-white rounded-lg border border-gray-200 p-4 hover:shadow-md hover:border-blue-300 transition-all no-underline"
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-base font-semibold text-gray-900 leading-snug mb-1 flex-1">
                {p.title}
              </h3>
              {p.documentNumber && (
                <span class="text-xs text-gray-400 whitespace-nowrap shrink-0">
                  {p.documentNumber}
                </span>
              )}
            </div>
            <div class="flex flex-wrap items-center gap-2 mt-2 text-xs">
              <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800">
                {p.sourceName || p.sourceId}
              </span>
              {p.publishDate && (
                <span class="text-gray-500">{p.publishDate}</span>
              )}
              {p.subcategory && category.subcategories?.find(s => s.id === p.subcategory) && (
                <span class="px-2 py-0.5 rounded bg-gray-100 text-gray-600">
                  {category.subcategories.find(s => s.id === p.subcategory)?.name}
                </span>
              )}
            </div>
            {p.summary && (
              <p class="text-sm text-gray-600 mt-2 line-clamp-2 leading-relaxed">
                {p.summary}
              </p>
            )}
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-gray-400">
        <p class="text-lg">暂无该分类下的政策数据</p>
        <p class="text-sm mt-1">爬虫部署后将自动采集。</p>
      </div>
    )}
  </div>
</BaseLayout>
