---
import { getAllCategories } from "../lib/categories";

export interface Props {
  mode?: "card" | "tab";
}

const { mode = "card" } = Astro.props;
const categories = getAllCategories();
---

{
  mode === "card" ? (
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {categories.map((cat) => (
        <a
          href={`/categories/${cat.id}`}
          class="block bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md hover:border-blue-300 transition-all no-underline"
        >
          <div class="text-xl mb-1">{cat.icon}</div>
          <h3 class="text-sm font-semibold text-gray-900">{cat.name}</h3>
          <p class="text-xs text-gray-500 mt-0.5 line-clamp-1">{cat.description}</p>
        </a>
      ))}
    </div>
  ) : (
    <nav class="flex flex-wrap gap-2">
      {categories.map((cat) => (
        <a
          href={`/categories/${cat.id}`}
          class="px-3 py-1.5 text-sm bg-white border border-gray-200 rounded-full hover:bg-blue-50 hover:border-blue-300 transition-colors no-underline text-gray-700"
        >
          {cat.icon} {cat.name}
        </a>
      ))}
    </nav>
  )
}
